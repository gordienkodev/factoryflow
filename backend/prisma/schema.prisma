generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Machine {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

enum OrderStatus {
  pending
  completed
}

model Order {
  id     Int         @id @default(autoincrement())
  number String      @unique
  name   String
  status OrderStatus @default(pending)
}
